        value               uniform (0 0 0);
    }

    outlet_1
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }

    outlet_2
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }

    outlet_3
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }

    wall
    {
        type            noSlip;
    }
}
